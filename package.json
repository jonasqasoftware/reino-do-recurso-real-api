{
  "name": "reino-do-recurso-real-api",
  "version": "2.0.0",
  "description": "Risk-based API Quality Engineering case study built with Express and OpenAPI.",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "test:ci": "node --experimental-test-coverage --test tests/*.test.js",
    "test:accessibility": "node tests/accessibility.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run format:check && npm run test:ci"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "api-testing",
    "contract-testing",
    "quality-engineering",
    "risk-based-testing",
    "openapi"
  ],
  "author": "Jonas Davila da Silva",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@axe-core/playwright": "^4.11.0",
    "eslint": "^8.57.1",
    "playwright": "^1.58.0",
    "prettier": "^3.7.4",
    "supertest": "^7.1.4",
    "wait-on": "^9.0.3"
  }
}
